<?xml version="1.0" encoding="utf-8"?>
<!--
    Automations call APIs the user chooses, including devices on the home network
    (Home Assistant, ESP, routers) that only speak plain http://. Unencrypted
    traffic is therefore allowed; https:// keeps working as usual.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
