<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device transfer on Android 12+. -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Secrets are encrypted with a Keystore key that is never backed up, so a restored copy could not be read. -->
        <exclude domain="sharedpref" path="secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secrets.xml" />
    </device-transfer>
</data-extraction-rules>
